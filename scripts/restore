#!/bin/bash

source /usr/share/yunohost/helpers

ynh_abort_if_errors

app=$YNH_APP_INSTANCE_NAME
domain=$YNH_APP_ARG_DOMAIN

ynh_script_progression --message="Restoring STT Whisper..." --weight=1

ynh_restore_file --origin_path="/var/www/$app"
ynh_restore_file --origin_path="/var/cache/$app"
ynh_restore_file --origin_path="/var/log/$app"
ynh_restore_file --origin_path="/etc/systemd/system/$app.service"
ynh_restore_file --origin_path="/etc/nginx/conf.d/$domain.d/$app.conf"

ynh_systemd_action --service_name=$app --action="start" --line_match="Application startup complete" --log_path="/var/log/$app/app.log" --timeout=60

ynh_script_progression --message="Restore of $app completed" --weight=1
