#!/bin/bash

source /usr/share/yunohost/helpers

ynh_abort_if_errors

app=$YNH_APP_INSTANCE_NAME
domain=$(ynh_app_setting_get --app=$app --key=domain)
path=$(ynh_app_setting_get --app=$app --key=path)
path=${path%/}

install_dir=$(ynh_app_setting_get --app=$app --key=install_dir)
port=$(ynh_app_setting_get --app=$app --key=port)

if [ -z "$port" ]; then
    port=$(ynh_find_port --port=9800)
    ynh_app_setting_set --app=$app --key=port --value=$port
fi

api_key=$(ynh_app_setting_get --app=$app --key=api_key)

# Never lose an existing key: recover it from config.yml, only generate if truly absent
if [ -z "$api_key" ] && [ -f "$install_dir/config.yml" ]; then
    api_key=$(grep '^  api_key:' "$install_dir/config.yml" | head -n1 | sed 's/.*"\(.*\)".*/\1/')
fi
if [ -z "$api_key" ]; then
    api_key=$(python3 -c "import secrets; print(secrets.token_hex(32))")
fi
ynh_app_setting_set --app=$app --key=api_key --value="$api_key"

# Same for allowed_ips: recover from config.yml if the setting is empty
allowed_ips=$(ynh_app_setting_get --app=$app --key=allowed_ips)
if [ -z "$allowed_ips" ] && [ -f "$install_dir/config.yml" ]; then
    allowed_ips=$(grep '^  allowed_ips:' "$install_dir/config.yml" | head -n1 | sed 's/.*"\(.*\)".*/\1/')
fi
allowed_ips=${allowed_ips:-"127.0.0.1,::1"}

model=$(ynh_app_setting_get --app=$app --key=model)
language=$(ynh_app_setting_get --app=$app --key=language)
is_public=$(ynh_app_setting_get --app=$app --key=is_public)

max_file_size_mb=25
threads=4
beam_size=5
host="127.0.0.1"

case "$model" in
    tiny) model_file="ggml-tiny.bin" ;;
    base) model_file="ggml-base.bin" ;;
    small) model_file="ggml-small.bin" ;;
    medium) model_file="ggml-medium.bin" ;;
    *) model_file="ggml-base.bin" ;;
esac

ynh_script_progression --message="Stopping service..." --weight=1
ynh_systemd_action --service_name=$app --action="stop"

ynh_script_progression --message="Upgrading source files..." --weight=1
cp -a "$YNH_APP_BASEDIR/sources/airi-stt/." "$install_dir/app/"

# Rebuild whisper.cpp if the existing binary is missing or cannot load its libraries
if [ ! -x "$install_dir/whisper/main" ] || ldd "$install_dir/whisper/main" 2>/dev/null | grep -q "not found"; then
    ynh_script_progression --message="Rebuilding whisper.cpp (binary broken or missing)..." --weight=15

    tmp_whisper=$(mktemp -d)
    git clone --depth 1 --branch v1.7.4 https://github.com/ggerganov/whisper.cpp.git "$tmp_whisper"

    (cmake -S "$tmp_whisper" -B "$tmp_whisper/build" \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_SHARED_LIBS=OFF \
        -DWHISPER_BUILD_TESTS=OFF \
        -DWHISPER_BUILD_SERVER=OFF \
        && cmake --build "$tmp_whisper/build" --config Release -j "$(nproc)")

    whisper_bin=""
    for candidate in whisper-cli main; do
        if [ -f "$tmp_whisper/build/bin/$candidate" ]; then
            whisper_bin="$tmp_whisper/build/bin/$candidate"
            break
        fi
    done
    if [ -z "$whisper_bin" ]; then
        rm -rf "$tmp_whisper"
        ynh_die --message="Could not rebuild whisper.cpp"
    fi

    cp "$whisper_bin" "$install_dir/whisper/main"
    find "$tmp_whisper" -name "*.so*" -exec cp -a {} "$install_dir/whisper/" \; 2>/dev/null || true
    rm -rf "$tmp_whisper"
fi

ynh_script_progression --message="Upgrading Python dependencies..." --weight=3
"$install_dir/venv/bin/pip" install --upgrade pip
"$install_dir/venv/bin/pip" install -r "$install_dir/app/requirements.txt"

ynh_script_progression --message="Updating configuration..." --weight=1
ynh_add_config --template="config.yml" --destination="$install_dir/config.yml"
chmod 600 "$install_dir/config.yml"

ynh_script_progression --message="Updating system configuration..." --weight=1
ynh_add_nginx_config
ynh_add_systemd_config

ynh_script_progression --message="Starting service..." --weight=2
ynh_systemd_action --service_name=$app --action="start" --line_match="Application startup complete" --log_path="/var/log/$app/app.log" --timeout=60

chown -R $app:$app "$install_dir"

if [ "$is_public" -eq 1 ]; then
    ynh_permission_update --permission="main" --add="visitors"
else
    ynh_permission_update --permission="main" --add="all_users"
fi

ynh_script_progression --message="Upgrade of $app completed" --weight=1
