#!/bin/bash
# internal generator used by fake cmake to create a fake whisper-cli
mkdir -p "$(dirname "$1")"
cat > "$1" <<'INNER'
#!/bin/bash
# Fake whisper-cli: accept whisper.cpp args, write canned transcript + JSON next to -f file
file_arg=""
out_base=""
out_txt=false
out_json=false
while [ $# -gt 0 ]; do
  case "$1" in
    -f) file_arg="$2"; shift 2 ;;
    -of) out_base="$2"; shift 2 ;;
    --output-txt) out_txt=true; shift ;;
    --output-json-full|-ojf|-oj) out_json=true; shift ;;
    --max-context|-m|-l|-t|-bs|--prompt) shift 2 ;;
    --no-timestamps|-tr|-nt|--print-colors|-pc|-s|-ml) shift ;;
    *) shift ;;
  esac
done
TXT="And so my fellow Americans ask not what your country can do for you ask what you can do for your country"
emit() {
  local base="$1"
  [ -z "$out_base" ] || base="$out_base"
  if [ "$out_txt" = "true" ]; then
    printf '%s\n' "$TXT" > "$base.txt"
  fi
  if [ "$out_json" = "true" ]; then
    cat > "$base.json" <<EOF
{"transcription":[
  {"offsets":[0,6200],"timestamps":["00:00:00,000","00:00:06,200"],
   "text":"$TXT",
   "tokens":[
     {"text":"And","p":0.93,"plog":-0.07},
     {"text":"so","p":0.94,"plog":-0.06},
     {"text":"my","p":0.95,"plog":-0.05},
     {"text":"fellow","p":0.96,"plog":-0.04},
     {"text":"Americans","p":0.90,"plog":-0.11},
     {"text":"country","p":0.88,"plog":-0.13}
   ]}
]}
EOF
  fi
}
if [ -n "$file_arg" ]; then
  emit "$file_arg"
fi
exit 0
INNER
chmod +x "$1"
